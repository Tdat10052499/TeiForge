# TeiForge does not load .env files itself; export these variables or use a tool such as direnv.

# LLM provider: openai, anthropic or none. Leave unset to auto-detect from the API keys below.
TEIFORGE_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override, e.g. gpt-4o-mini, claude-sonnet-5-5, or llama3.1 for Ollama.
TEIFORGE_MODEL=

# Optional OpenAI-compatible endpoint, e.g. Ollama: http://localhost:11434/v1
TEIFORGE_BASE_URL=

# Directory that file tools are confined to (default: the current directory).
TEIFORGE_WORKSPACE=

# Keep command execution disabled unless you need the restricted built-in commands.
TEIFORGE_ENABLE_COMMANDS=0
